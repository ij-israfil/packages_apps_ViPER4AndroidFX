android_app_import {
    name: "ViPER4AndroidFX",
    owner: "ViperFX",
    apk: "system-ext/app/ViPER4AndroidFX/ViPER4AndroidFX.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: ["AudioFX", "MusicFX"],
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libv4a_fx",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: [
                "vendor/lib/soundfx/libv4a_fx.so",
            ],
            shared_libs: [
                "liblog",
                "libstdc++_vendor",
                "libm",
                "libc",
                "libdl",
            ],
        },
    },
    compile_multilib: "32",
    relative_install_path: "soundfx",
    prefer: true,
    soc_specific: true,
}